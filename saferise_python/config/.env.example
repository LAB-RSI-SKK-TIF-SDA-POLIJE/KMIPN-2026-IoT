# SafeRise - Template konfigurasi environment
# ============================================
# Cara pakai:
#   1. Salin file ini jadi config/.env   (config/.env TIDAK ikut di-commit,
#      sudah masuk .gitignore -- jangan pernah commit password asli)
#   2. Isi nilai yang dibutuhkan (minimal MQTT_PASSWORD)
#   3. Baris yang diawali # adalah komentar; format: NAMA_VAR=nilai
#
# Prioritas: env var terminal > config/.env > default di settings.py.
# Tanpa file ini pun tetap bisa jalan, asal set env var manual:
#     Windows PowerShell : $env:MQTT_PASSWORD="xxx"
#     Linux/Pi           : export MQTT_PASSWORD=xxx

# --- MQTT (broker HiveMQ Cloud, TLS) ---
MQTT_HOST=1c66eefbd54741318908908707bafb17.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USERNAME=syahrizal
MQTT_PASSWORD=
# Set 0 only when using a trusted-LAN MQTT broker, usually port 1883.
MQTT_TLS_ENABLED=1

# --- Identitas kamera & topic ---
CAMERA_ID=CAM05
LOCATION=Rooftop Gedung A

# --- Model (kosong = pakai default varian masing-masing) ---
# pi_publisher_yolo.py       -> models/yolov8n-pose.pt
# pi_publisher_yolo_lite.py  -> models/yolov8n-pose_ncnn_model
# pi_publisher_yolo_tflite.py -> WAJIB diisi path model INT8 hasil export
YOLO_MODEL=

# --- Ambang deteksi & postur (hasil kalibrasi) ---
CONF_THRESHOLD=0.5
KEYPOINT_CONF_THRESHOLD=0.3
NARROW_STANCE_RATIO=0.35
LEG_RAISED_RATIO=0.30
CROUCH_KNEE_ANGLE_MAX=140.0
# Danger zone harus dikalibrasi untuk resolusi kamera yang dipakai.
# Format JSON satu baris. Kosong = default 320x240 di settings.py.
# DANGER_ZONE_POINTS=[[25,144],[295,144],[295,230],[25,230]]

# --- Debounce status & interval publish (detik / frame) ---
DANGER_CONSECUTIVE_FRAMES=5
HIGH_RISK_CONSECUTIVE_FRAMES=2
DANGER_REPUBLISH_INTERVAL=10
NORMAL_PUBLISH_INTERVAL=5

# --- DFPlayer Mini (audio intervensi lokal) ---
AUDIO_ENABLED=0
DFPLAYER_PORT=/dev/serial0
DFPLAYER_VOLUME=20
AUDIO_TRACK_MEDIUM=1
AUDIO_TRACK_HIGH=2
AUDIO_REPLAY_INTERVAL=15

# --- Kamera ---
CAMERA_SOURCE=0
CAMERA_BACKEND=picamera2
FRAME_WIDTH=320
FRAME_HEIGHT=240
PROCESS_EVERY_N_FRAMES=3
SHOW_PREVIEW=0

# --- Live stream MJPEG (pi_publisher_yolo.py) ---
MJPEG_ENABLED=1
MJPEG_PORT=8000
MJPEG_QUALITY=70
MJPEG_FPS=10

# --- Motion-gating (pi_publisher_yolo_lite.py / _tflite.py) ---
MOTION_GATING_ENABLED=1
MOTION_PIXEL_THRESHOLD=400
MOTION_DIFF_THRESHOLD=25
FORCE_INFERENCE_INTERVAL=5.0

# --- Pi Camera 3 H.264 stream + alarm agent (inference dilakukan laptop) ---
# STREAM_URL hanya diperlukan di laptop, contoh: tcp://192.168.1.50:8888
STREAM_PORT=8888
STREAM_FPS=15
STREAM_URL=

# --- Broker alarm command Pi<->laptop (opsional, dual-broker) ---
# Kosongkan LOCAL_MQTT_HOST supaya alarm command ikut lewat HiveMQ Cloud
# di atas (satu broker untuk semua, paling sederhana).
# Isi dengan IP laptop yang menjalankan Mosquitto (lihat SETUP_PI3_LAPTOP.md
# bagian D) supaya alarm command TIDAK bergantung internet -- status
# detection ke app Flutter tetap lewat HiveMQ seperti biasa, tidak terpengaruh.
LOCAL_MQTT_HOST=
LOCAL_MQTT_PORT=1883
LOCAL_MQTT_USERNAME=
LOCAL_MQTT_PASSWORD=
LOCAL_MQTT_TLS_ENABLED=0
